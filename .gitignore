# ==========================================
# PostgreSQL local files and backups
# ==========================================
*.dump
*.backup
*.bak
*.sql.gz
*.pgdata/

# PostgreSQL Docker data should live in a
# named volume, not in the Git repository.
postgres-data/
pgdata/

# ==========================================
# Docker and local overrides
# ==========================================
docker-compose.override.yml
compose.override.yaml

# ==========================================
# Test and temporary files
# ==========================================
.tmp/
temp/
tmp/
*.tmp
*.swp
