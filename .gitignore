# Angular / Node.js / NestJS
# ==========================================
node_modules/
dist/
.angular/
coverage/
.nx/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.tsbuildinfo

# NestJS build output
# (dist/ is already ignored above)

