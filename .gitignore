.env
.env.*
!.env.example
!.env.template

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# ==========================================
# macOS and IDE files
# ==========================================
.DS_Store
.AppleDouble
.LSOverride
.idea/
.vscode/
*.swp
*.swo
*~

